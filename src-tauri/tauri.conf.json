{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoTask",
  "version": "2.4.1",
  "identifier": "app.chronotask.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChronoTask — Tasks & Alarms",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#111317"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "ChronoTask",
    "copyright": "© 2026 ChronoTask",
    "category": "Productivity",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
